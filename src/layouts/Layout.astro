---
import "../styles/global.css";
import Analytics from '@vercel/analytics/astro';

interface Props {
	title?: string;
	description?: string;
	canonicalUrl?: string;
	robots?: string;
	hideScrollTop?: boolean;
}

const { 
	title = "Do Not Stop Writing - The Dangerous Writing App",
	description = "Defeat writer's block and get in the flow state instantly. Do Not Stop Writing is a dangerous writing app that deletes your progress if you stop typing.",
	canonicalUrl = "https://donotstopwriting.com",
	robots,
	hideScrollTop = false
} = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
		<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
		<link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
		<link rel="manifest" href="/site.webmanifest" />
		<link rel="shortcut icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		
		<!-- SEO Meta Tags -->
		{robots && <meta name="robots" content={robots} />}
		<meta name="description" content={description} />
		<link rel="canonical" href={canonicalUrl} />
		<meta name="google-adsense-account" content="ca-pub-3867408802205981" />

		<!-- Open Graph / Facebook -->
		<meta property="og:type" content="website" />
		<meta property="og:url" content={canonicalUrl} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:image" content="https://donotstopwriting.com/og-image.jpg" />

		<!-- Twitter -->
		<meta property="twitter:card" content="summary_large_image" />
		<meta property="twitter:url" content={canonicalUrl} />
		<meta property="twitter:title" content={title} />
		<meta property="twitter:description" content={description} />
		<meta property="twitter:image" content="https://donotstopwriting.com/og-image.jpg" />

		<!-- JSON-LD Structured Data -->
		<script type="application/ld+json" is:inline>
			{
				"@context": "https://schema.org",
				"@type": "WebApplication",
				"name": "Do Not Stop Writing",
				"url": "https://donotstopwriting.com",
				"description": "A minimalist, dangerous writing application that forces users to write continuously by deleting their work if they stop typing for too long. Helps writers beat writer's block and enter flow state.",
				"applicationCategory": "ProductivityApplication",
				"operatingSystem": "All",
				"offers": {
					"@type": "Offer",
					"price": "0",
					"priceCurrency": "USD"
				}
			}
		</script>

		<!-- Google AdSense -->
		<script async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-3867408802205981" crossorigin="anonymous"></script>

		<!-- Consent Manager: gates Google Analytics & Google AdSense behind user consent (GDPR/ePrivacy) -->
		<script is:inline>
			(function () {
				var CONSENT_KEY = 'dsw-consent';
				var consent = null;
				try { consent = localStorage.getItem(CONSENT_KEY); } catch (e) {}

				window.dataLayer = window.dataLayer || [];
				function gtag() { dataLayer.push(arguments); }

				// Google Consent Mode v2: default to denied until the user makes a choice
				gtag('consent', 'default', {
					ad_storage: 'denied',
					ad_user_data: 'denied',
					ad_personalization: 'denied',
					analytics_storage: 'denied',
					functionality_storage: 'granted',
					personalization_storage: 'denied',
					security_storage: 'granted',
					wait_for_update: 500
				});

				var gaLoaded = false;
				var adLoaded = false;

				function loadScript(src, crossOrigin) {
					var s = document.createElement('script');
					s.async = true;
					s.src = src;
					if (crossOrigin) s.crossOrigin = 'anonymous';
					document.head.appendChild(s);
				}

				function loadAnalytics() {
					if (gaLoaded) return;
					gaLoaded = true;
					loadScript('https://www.googletagmanager.com/gtag/js?id=G-Z8K56WV409');
					gtag('js', new Date());
					gtag('config', 'G-Z8K56WV409');
				}

				function loadAdSense() {
					if (adLoaded) return;
					adLoaded = true;
					loadScript('https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-3867408802205981', true);
				}

				if (consent === 'accepted') {
					gtag('consent', 'update', {
						ad_storage: 'granted',
						ad_user_data: 'granted',
						ad_personalization: 'granted',
						analytics_storage: 'granted'
					});
					loadAnalytics();
					loadAdSense();
				}

				window.__dswConsent = consent;
				window.__dswSetConsent = function (value) {
					try { localStorage.setItem(CONSENT_KEY, value); } catch (e) {}
					window.__dswConsent = value;

					if (value === 'accepted') {
						gtag('consent', 'update', {
							ad_storage: 'granted',
							ad_user_data: 'granted',
							ad_personalization: 'granted',
							analytics_storage: 'granted'
						});
						loadAnalytics();
						loadAdSense();
					} else {
						gtag('consent', 'update', {
							ad_storage: 'denied',
							ad_user_data: 'denied',
							ad_personalization: 'denied',
							analytics_storage: 'denied'
						});
					}
				};
			})();
		</script>

		<script is:inline>
			const theme = (() => {
			if (typeof localStorage !== 'undefined' && localStorage.getItem('theme')) {
				return localStorage.getItem('theme');
			}
			// Default to light mode unless user has explicitly chosen dark
			return 'light';
		})();

		if (theme === 'light') {
			document.documentElement.classList.remove('dark');
		} else {
			document.documentElement.classList.add('dark');
		}
		window.localStorage.setItem('theme', theme);

		// OS check to apply custom macOS cursor/scrollbar on Windows & Linux
		if (typeof navigator !== 'undefined' && !/Mac|iPhone|iPod|iPad/i.test(navigator.userAgent)) {
			document.documentElement.classList.add('custom-macos-theme');
		}
		</script>

		<!-- Register Service Worker for PWA installability -->
		<script is:inline>
			if ('serviceWorker' in navigator) {
				window.addEventListener('load', () => {
					navigator.serviceWorker.register('/sw.js')
						.then(reg => console.log('Service Worker registered successfully!', reg.scope))
						.catch(err => console.error('Service Worker registration failed:', err));
				});
			}
		</script>
	</head>
	<body class="min-h-screen bg-background text-primary dark:bg-[#111111] dark:text-neutral-100 transition-colors duration-300">
		<slot />

		{!hideScrollTop && (
			<button
				id="scroll-to-top"
				aria-label="Scroll to top"
				title="Back to top"
				class="scroll-top-btn"
			>
				<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
					<polyline points="18 15 12 9 6 15" />
				</svg>
			</button>
		)}

		{!hideScrollTop && (
			<script is:inline>
				(function () {
					const btn = document.getElementById('scroll-to-top');
					if (!btn) return;

					// Show/hide on scroll
					window.addEventListener('scroll', function () {
						if (window.scrollY > 300) {
							btn.classList.add('visible');
						} else {
							btn.classList.remove('visible');
						}
					}, { passive: true });

					// Scroll to top on click
					btn.addEventListener('click', function () {
						window.scrollTo({ top: 0, behavior: 'smooth' });
					});

					// Initial dark mode styling
					function applyTheme() {
						if (document.documentElement.classList.contains('dark')) {
							btn.style.background = 'rgba(30,30,30,0.85)';
							btn.style.borderColor = 'rgba(255,255,255,0.1)';
							btn.style.color = '#e5e5e5';
						} else {
							btn.style.background = 'rgba(255,255,255,0.85)';
							btn.style.borderColor = 'rgba(0,0,0,0.1)';
							btn.style.color = '#111111';
						}
					}
					applyTheme();

					// Watch for theme changes
					new MutationObserver(applyTheme).observe(
						document.documentElement,
						{ attributes: true, attributeFilter: ['class'] }
					);
				})();
			</script>
		)}
		<!-- Cookie Consent Banner (shown until the user makes a choice) -->
		<div id="cookie-consent" role="dialog" aria-modal="false" aria-label="Cookie consent"
			class="fixed bottom-0 left-0 right-0 z-[200] transition-all duration-500 ease-out translate-y-full opacity-0">
			<div class="max-w-3xl mx-auto m-4 p-5 md:p-6 rounded-2xl border border-neutral-200 dark:border-neutral-800 bg-white dark:bg-[#161616] shadow-[0_16px_48px_rgba(0,0,0,0.18)] dark:shadow-[0_16px_48px_rgba(0,0,0,0.6)]">
				<div class="flex flex-col md:flex-row md:items-center gap-4 md:gap-6">
					<div class="flex-1 font-sans text-[13px] leading-relaxed text-neutral-600 dark:text-neutral-300">
						<p class="font-serif text-[15px] font-bold text-primary dark:text-white mb-1">We value your privacy</p>
						<p>
							We use cookies and similar technologies, including from third parties such as Google,
							to measure site usage and serve relevant advertising. You can choose to accept or decline
							non-essential cookies below. Read our
							<a href="/privacy" class="underline hover:opacity-80 font-semibold no-underline">Privacy Policy</a>
							and
							<a href="/terms" class="underline hover:opacity-80 font-semibold no-underline">Terms</a>
							for full details. Your choice is saved locally and can be changed at any time.
						</p>
					</div>
					<div class="flex flex-row items-center gap-3 md:flex-col md:items-stretch">
						<button id="cc-accept"
							class="px-5 py-2.5 bg-[#111111] dark:bg-white text-white dark:text-[#111111] hover:bg-[#222222] dark:hover:bg-neutral-100 text-xs font-bold rounded-full transition-colors cursor-pointer select-none">
							Accept
						</button>
						<button id="cc-decline"
							class="px-5 py-2.5 border border-neutral-200 dark:border-neutral-700 text-neutral-700 dark:text-neutral-300 hover:bg-neutral-50 dark:hover:bg-neutral-900 text-xs font-bold rounded-full transition-colors cursor-pointer select-none">
							Decline
						</button>
					</div>
				</div>
			</div>
		</div>

		<script is:inline>
			(function () {
				var banner = document.getElementById('cookie-consent');
				if (!banner) return;

				// If a choice was already made (or stored), never show the banner
				if (window.__dswConsent !== null && window.__dswConsent !== undefined) {
					banner.remove();
					return;
				}

				function hideBanner() {
					banner.classList.remove('translate-y-full');
					banner.classList.add('opacity-0');
					setTimeout(function () { banner.remove(); }, 500);
				}

				document.getElementById('cc-accept').addEventListener('click', function () {
					if (window.__dswSetConsent) window.__dswSetConsent('accepted');
					hideBanner();
				});

				document.getElementById('cc-decline').addEventListener('click', function () {
					if (window.__dswSetConsent) window.__dswSetConsent('declined');
					hideBanner();
				});

				// Slide the banner in after the page settles
				setTimeout(function () {
					banner.classList.remove('translate-y-full', 'opacity-0');
				}, 600);
			})();
		</script>

		<Analytics />
	</body>
</html>

<style is:global>
	:root {
		--font-sans: "Geist", "Inter", ui-sans-serif, system-ui, sans-serif;
	}

	html,
	body {
		margin: 0;
		width: 100%;
		min-height: 100%;
		overflow-x: hidden;
	}

	/* Vercel-like scrollbar for native macOS or other defaults */
	::-webkit-scrollbar {
		width: 8px;
		height: 8px;
	}
	::-webkit-scrollbar-track {
		background: transparent;
	}
	::-webkit-scrollbar-thumb {
		background: #888;
		border-radius: 10px;
	}
	::-webkit-scrollbar-thumb:hover {
		background: #555;
	}

	.dark ::-webkit-scrollbar-thumb {
		background: #333;
	}
	.dark ::-webkit-scrollbar-thumb:hover {
		background: #444;
	}

	/* macOS Style Cursors for Windows/Linux */
	.custom-macos-theme,
	.custom-macos-theme * {
		cursor: url("../assets/mac cursor/cursor.svg") 8 5, auto !important;
	}

	.custom-macos-theme a,
	.custom-macos-theme button,
	.custom-macos-theme select,
	.custom-macos-theme input[type="submit"],
	.custom-macos-theme input[type="button"],
	.custom-macos-theme [role="button"],
	.custom-macos-theme .cursor-pointer,
	.custom-macos-theme label,
	.custom-macos-theme a *,
	.custom-macos-theme button * {
		cursor: url("../assets/mac cursor/pointinghand.svg") 12 2, pointer !important;
	}

	.custom-macos-theme textarea,
	.custom-macos-theme input[type="text"],
	.custom-macos-theme input[type="number"],
	.custom-macos-theme input[type="email"],
	.custom-macos-theme input[type="password"],
	.custom-macos-theme input[type="search"],
	.custom-macos-theme [contenteditable] {
		cursor: text !important;
	}

	.custom-macos-theme :disabled,
	.custom-macos-theme .cursor-not-allowed,
	.custom-macos-theme [aria-disabled="true"] {
		cursor: url("../assets/mac cursor/notallowed.svg") 10 10, not-allowed !important;
	}

	.custom-macos-theme .cursor-grab,
	.custom-macos-theme [draggable="true"] {
		cursor: url("../assets/mac cursor/openhand.svg") 10 10, grab !important;
	}

	.custom-macos-theme .cursor-grabbing {
		cursor: url("../assets/mac cursor/closedhand.svg") 10 10, grabbing !important;
	}

	.custom-macos-theme .cursor-help {
		cursor: url("../assets/mac cursor/help.svg") 10 10, help !important;
	}

	.custom-macos-theme .cursor-zoom-in {
		cursor: url("../assets/mac cursor/zoomin.svg") 10 10, zoom-in !important;
	}

	.custom-macos-theme .cursor-zoom-out {
		cursor: url("../assets/mac cursor/zoomout.svg") 10 10, zoom-out !important;
	}

	.custom-macos-theme .cursor-move {
		cursor: url("../assets/mac cursor/move.svg") 10 10, move !important;
	}

	.custom-macos-theme .cursor-nesw-resize {
		cursor: url("../assets/mac cursor/resizenortheastsouthwest.svg") 10 10, nesw-resize !important;
	}

	/* macOS Style Scrollbar for Windows/Linux (WebKit) */
	.custom-macos-theme::-webkit-scrollbar {
		width: 8px;
		height: 8px;
	}
	.custom-macos-theme::-webkit-scrollbar-track {
		background: transparent;
	}
	.custom-macos-theme::-webkit-scrollbar-thumb {
		background: rgba(120, 120, 120, 0.4);
		border-radius: 10px;
		border: 2px solid transparent;
		background-clip: padding-box;
	}
	.custom-macos-theme::-webkit-scrollbar-thumb:hover {
		background: rgba(100, 100, 100, 0.7);
		border: 2px solid transparent;
		background-clip: padding-box;
	}

	.custom-macos-theme.dark::-webkit-scrollbar-thumb {
		background: rgba(150, 150, 150, 0.3);
		border: 2px solid transparent;
		background-clip: padding-box;
	}
	.custom-macos-theme.dark::-webkit-scrollbar-thumb:hover {
		background: rgba(180, 180, 180, 0.5);
		border: 2px solid transparent;
		background-clip: padding-box;
	}

	/* macOS Style Scrollbar for Windows/Linux (Firefox) */
	html.custom-macos-theme {
		scrollbar-width: thin;
		scrollbar-color: rgba(120, 120, 120, 0.4) transparent;
	}
	html.custom-macos-theme.dark {
		scrollbar-color: rgba(150, 150, 150, 0.3) transparent;
	}
</style>
