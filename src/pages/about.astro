---
import Layout from '../layouts/Layout.astro';
import ThemeToggle from '../components/ThemeToggle';
---

<Layout 
	title="About - Do Not Stop Writing | Beat Writer's Block"
	description="Learn about the philosophy and features of Do Not Stop Writing, the free browser-based writing tool designed to help you defeat writer's block."
>
	<!-- Sticky top navigation bar -->
	<header class="sticky top-0 z-50 w-full bg-white dark:bg-[#111111] border-b border-neutral-100 dark:border-neutral-900 transition-colors duration-300">
		<div class="max-w-[1200px] mx-auto px-6 md:px-8 h-14 flex items-center justify-between">
			<!-- Logo on left -->
			<a 
				href="/" 
				id="logo" 
				class="font-serif text-[19px] tracking-wide text-primary dark:text-neutral-100 lowercase select-none hover:opacity-85 no-underline font-normal"
			>
				donotstopwriting.com
			</a>
			<!-- Actions on right -->
			<div class="flex items-center space-x-3">
				<a 
					href="/" 
					class="flex items-center gap-1.5 px-3.5 py-1.5 border border-neutral-200 dark:border-neutral-800 rounded-lg bg-white dark:bg-neutral-950 text-xs md:text-sm font-serif font-semibold hover:bg-neutral-50 dark:hover:bg-neutral-900 text-primary dark:text-neutral-200 shadow-sm transition-all duration-200 no-underline cursor-pointer"
				>
					<span class="text-xs">→</span> Start Writing
				</a>
				<ThemeToggle client:load />
			</div>
		</div>
	</header>

	<main class="w-full bg-white dark:bg-[#111111] transition-colors duration-300 min-h-screen py-16 px-6 md:px-8">
		<div class="subpage-container flex flex-col font-serif max-w-[720px] mx-auto space-y-10">
			<!-- Back Navigation -->
			<div>
				<a 
					href="/" 
					class="inline-flex items-center text-[13px] text-neutral-400 dark:text-neutral-500 hover:text-primary dark:hover:text-neutral-200 transition-colors duration-200 no-underline font-sans"
				>
					<span class="mr-1.5">←</span> Back to Home
				</a>
			</div>

			<!-- Hero Title & Subtitle -->
			<div class="space-y-4">
				<h1 class="text-[32px] md:text-[38px] font-bold tracking-tight text-primary dark:text-white leading-[1.15]">
					About Do Not Stop Writing
				</h1>
				<h2 class="text-xl md:text-[22px] font-medium text-neutral-600 dark:text-neutral-400 leading-relaxed font-serif">
					The Free Online Writing Challenge Tool That Helps You Beat Writer's Block
				</h2>
				<p class="text-sm text-neutral-400 dark:text-neutral-500 font-sans">
					Last updated: 18 August 2026
				</p>
			</div>

			<!-- Publisher & Contact Disclosure -->
			<div class="font-sans text-sm leading-relaxed text-neutral-700 dark:text-neutral-300 space-y-3">
				<h2 class="text-xl md:text-2xl font-bold text-primary dark:text-white tracking-tight">Who We Are</h2>
				<p>
					<strong>Do Not Stop Writing</strong> is an independent web application created by <strong>Deepanshu Kashyap</strong>. Alongside the writing app, we also publish a small suite of free, privacy-first browser tools — you can explore them below.
				</p>
			</div>

			<!-- Intro Body Content -->
			<div class="space-y-6 text-base md:text-[17px] leading-[1.8] text-neutral-800 dark:text-neutral-300">
				<p>
					<strong>Do Not Stop Writing</strong> is a free online writing tool with one simple rule: keep typing or lose your progress. If you pause for more than a few seconds, the screen blurs and your session is deleted — forcing you to focus on creating instead of perfecting.
				</p>
				<p>
					Everything runs directly in your browser. There is no account, no install, and no background tracking — your words never leave your device.
				</p>
			</div>
			<!-- Open Source Highlight Callout -->
			<p class="text-base md:text-[17px] leading-[1.8] text-neutral-800 dark:text-neutral-300 font-serif">
				<span class="hand-drawn-highlight">This site is completely <strong class="font-bold">open source</strong>. You can see the complete code on our <a href="https://github.com/DeepanshuK2002/donotstopwriting" target="_blank" rel="noopener noreferrer" class="font-semibold hover:opacity-85">github repo</a>.</span>
			</p>

			<!-- About Docs Summary -->
			<div class="space-y-5 text-sm md:text-[15px] leading-relaxed text-neutral-700 dark:text-neutral-300 pt-4">
				<div class="space-y-1">
					<h2 class="text-base font-bold text-primary dark:text-white tracking-tight">Features</h2>
					<p>
						Set a writing timer (3–60 minutes) or a word-count target (250–2000 words) and track your progress in real time. Write on a distraction-free interface with no toolbars, margins, or spell-check underlines. Enable Hardcore Blind Mode to permanently blur everything except the word you are typing, so you can't look back and self-edit mid-session. Copying and selecting are disabled while writing; finish your goal and download your draft in multiple formats.
					</p>
				</div>
				<div class="space-y-1">
					<h2 class="text-base font-bold text-primary dark:text-white tracking-tight">Our Philosophy</h2>
					<p>
						Writer's block is rarely a lack of ideas — it's the paralysis that comes from editing while you create. Every feature in Do Not Stop Writing is built around one goal: <em>helping you write without stopping. Write first. Edit later.</em>
					</p>
				</div>
				<div class="space-y-1">
					<h2 class="text-base font-bold text-primary dark:text-white tracking-tight">Who Is This Tool For?</h2>
					<p>
						Students, bloggers, authors, novelists, screenwriters, journalists, copywriters, content creators, freelance writers, researchers, and academic writers — anyone looking to improve writing productivity. Whether you're writing an essay, article, book, script, journal entry, assignment, or blog post, Do Not Stop Writing helps you stay focused and productive.
					</p>
				</div>
			</div>

			<hr class="border-t border-neutral-150 dark:border-neutral-900" />

			<!-- Download Logo Button -->
			<div class="pt-2">
				<a 
					href="/original-icon.png" 
					download="www.donotstopwriting.com.png"
					class="inline-flex items-center gap-2 px-4 py-2 border border-neutral-200 dark:border-neutral-800 rounded-lg text-sm font-sans font-semibold hover:bg-neutral-50 dark:hover:bg-neutral-900 text-primary dark:text-neutral-200 shadow-sm transition-all duration-200 cursor-pointer no-underline"
				>
					<svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
						<path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4" />
						<polyline points="7 10 12 15 17 10" />
						<line x1="12" y1="15" x2="12" y2="3" />
					</svg>
					Download Logo
				</a>
			</div>

			<!-- The Creator Section -->
			<div class="space-y-6">
				<h2 class="text-xl md:text-2xl font-bold text-primary dark:text-white tracking-tight">
					The Creator
				</h2>
				<div class="pt-4">
					<!-- Bio -->
					<div class="space-y-4 text-base md:text-[17px] leading-[1.8] text-neutral-800 dark:text-neutral-300 font-serif">
						<div class="space-y-1">
							<h3 class="text-lg md:text-xl font-bold text-primary dark:text-white">Deepanshu Kashyap</h3>
							<p class="text-xs font-sans font-bold text-[#E52525] tracking-wider uppercase">Developer & Writer</p>
						</div>
						<p>
							My name is <strong>Deepanshu Kashyap</strong>, an aspiring developer and writer. I developed this tool because I got stuck in the slumber of perfectionism and was never able to complete my projects, looking to AI to help fix it.
						</p>
						<p>
							I use this website to write whatever I want—simply putting my brain out on the page and fixing it later.
						</p>
						<p class="border-l-2 border-[#E52525] pl-4 italic font-medium text-neutral-900 dark:text-neutral-200">
							This is the original website for this idea—other tools you see online today are copies of this project.
						</p>
						<div class="flex flex-wrap gap-3 pt-2">
							<!-- GitHub Link -->
							<a 
								href="https://github.com/DeepanshuK2002" 
								target="_blank" 
								rel="noopener noreferrer" 
								class="inline-flex items-center gap-2 px-4 py-2 border border-neutral-200 dark:border-neutral-850 rounded-lg text-sm font-sans font-semibold hover:bg-neutral-50 dark:hover:bg-neutral-900 text-primary dark:text-neutral-200 shadow-sm transition-all duration-200 no-underline cursor-pointer"
							>
								<svg class="w-4 h-4 fill-current" viewBox="0 0 24 24" aria-hidden="true">
									<path fill-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.27C22 6.484 17.522 2 12 2z" clip-rule="evenodd" />
								</svg>
								GitHub
							</a>
							<!-- X Link -->
							<a 
								href="https://x.com/Deepanshuk2002" 
								target="_blank" 
								rel="noopener noreferrer" 
								class="inline-flex items-center gap-2 px-4 py-2 border border-neutral-200 dark:border-neutral-850 rounded-lg text-sm font-sans font-semibold hover:bg-neutral-50 dark:hover:bg-neutral-900 text-primary dark:text-neutral-200 shadow-sm transition-all duration-200 no-underline cursor-pointer"
							>
								<svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 24 24" aria-hidden="true">
									<path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>
								</svg>
								Follow on X
							</a>
						</div>
					</div>
				</div>
			</div>

			<hr class="border-t border-neutral-150 dark:border-neutral-900" />

			<!-- Original Icon Section -->
			<div class="space-y-6">
				<h2 class="text-xl md:text-2xl font-bold text-primary dark:text-white tracking-tight">
					Our Original Icon
				</h2>
				<div class="flex flex-col md:flex-row items-center gap-8 bg-neutral-50 dark:bg-neutral-900/50 p-6 rounded-2xl border border-neutral-100 dark:border-neutral-800">
					<div class="relative w-24 h-24 flex-shrink-0 mx-auto md:mx-0 md:ml-3 flex items-center justify-center">
						<img 
							src="/original-icon.png" 
							alt="Do Not Stop Writing Original Icon" 
							class="w-full h-full object-contain"
						/>
					</div>
					<div class="flex-1 text-center md:text-left space-y-4 font-serif">
						<p class="text-base md:text-[17px] leading-[1.8] text-neutral-800 dark:text-neutral-300">
							This is the <strong>original icon</strong> of Do Not Stop Writing. Symbolizing both the bubble of creative stream-of-consciousness and the dangerous precision of the writing instrument, this icon represents the authentic and original concept that has inspired writing apps worldwide.
						</p>
						<div class="flex flex-col sm:flex-row items-center justify-between gap-4 pt-1">
							<p class="text-xs text-neutral-400 dark:text-neutral-500 font-sans">
								Designed specifically to represent distraction-free flow and high-stakes draft creation.
							</p>
							<a 
								href="/original-icon.png" 
								download="www.donotstopwriting.com.png"
								class="inline-flex items-center gap-2 px-3.5 py-2 border border-neutral-200 dark:border-neutral-800 rounded-lg text-xs font-sans font-semibold hover:bg-neutral-50 dark:hover:bg-neutral-900 text-neutral-600 dark:text-neutral-400 hover:text-primary dark:hover:text-neutral-200 shadow-sm transition-all duration-200 cursor-pointer flex-shrink-0 no-underline"
							>
								<svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
									<path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4" />
									<polyline points="7 10 12 15 17 10" />
									<line x1="12" y1="15" x2="12" y2="3" />
								</svg>
								Download Icon
							</a>
						</div>
					</div>
				</div>
			</div>

			<!-- Other Projects Section -->
			<h2 class="text-xl md:text-2xl font-bold text-primary dark:text-white tracking-tight pt-8">
				Other Projects
			</h2>

			<!-- dropdata Section -->
			<div class="space-y-6">
				<div class="bg-neutral-50 dark:bg-neutral-900/50 p-6 rounded-2xl border border-neutral-100 dark:border-neutral-800 space-y-6">
					<div class="flex flex-col md:flex-row items-center gap-8">
						<div class="relative w-24 h-24 flex-shrink-0 mx-auto md:mx-0 md:ml-3 flex items-center justify-center">
							<img 
								src="/dropdata-icon.png" 
								alt="dropdata Logo Icon" 
								class="w-full h-full object-contain"
							/>
						</div>
						<div class="flex-1 text-center md:text-left space-y-4 font-serif">
							<!-- Brand name inside card -->
							<div class="flex items-center gap-3 justify-center md:justify-start">
								<span class="font-serif text-[22px] md:text-[26px] font-bold tracking-tight text-primary dark:text-white leading-none">dropdata</span>
								<span class="text-[10px] font-sans font-bold tracking-wider text-blue-500 bg-blue-500/10 px-2.5 py-0.5 rounded-full uppercase">Web Utility</span>
							</div>
							<p class="text-base md:text-[17px] leading-[1.8] text-neutral-800 dark:text-neutral-300">
								<strong>dropdata</strong> is our peer-to-peer, tab-based file sharing utility. Designed to represent the fluid flow of data packages securely dropping from one browser tab into another through an encrypted tunnel, it features a modern split-capsule interface inside a premium metallic frame.
							</p>
							<div class="flex flex-col sm:flex-row items-center justify-between gap-4 pt-1">
								<p class="text-xs text-neutral-400 dark:text-neutral-500 font-sans">
									Official branding symbol for dropdata secure local-first file transfer services.
								</p>
								<a 
									href="/dropdata-icon.png" 
									download="dropdata-logo.png"
									class="inline-flex items-center gap-2 px-3.5 py-2 border border-neutral-200 dark:border-neutral-800 rounded-lg text-xs font-sans font-semibold hover:bg-neutral-50 dark:hover:bg-neutral-900 text-neutral-600 dark:text-neutral-400 hover:text-primary dark:hover:text-neutral-200 shadow-sm transition-all duration-200 cursor-pointer flex-shrink-0 no-underline"
								>
									<svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
										<path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4" />
										<polyline points="7 10 12 15 17 10" />
										<line x1="12" y1="15" x2="12" y2="3" />
									</svg>
									Download Logo
								</a>
							</div>
						</div>
					</div>

					<hr class="border-t border-neutral-100 dark:border-neutral-900/40 opacity-60" />

					<!-- dropdata Features Docs -->
					<div class="space-y-4">
						<h3 class="text-lg md:text-xl font-bold text-neutral-400 dark:text-neutral-500 font-sans tracking-tight">
							Key Features & Architecture
						</h3>
						<div class="space-y-3 font-sans text-sm leading-relaxed text-neutral-600 dark:text-neutral-400">
							<div class="space-y-0.5">
								<h4 class="font-bold text-neutral-900 dark:text-white">Serverless Direct P2P</h4>
								<p>Uses secure WebRTC data channels to transfer files directly between browser tabs. Since files never pass through or live on any cloud server, transfers are fast, unlimited in size, and completely private.</p>
							</div>
							<div class="space-y-0.5">
								<h4 class="font-bold text-neutral-900 dark:text-white">5-Minute Secure Expiry</h4>
								<p>Connections are protected by a rolling 5-minute security window. A visible, dynamic countdown timer rotates room codes automatically to ensure stale codes cannot be used.</p>
							</div>
							<div class="space-y-0.5">
								<h4 class="font-bold text-neutral-900 dark:text-white">Instant Code Rotation</h4>
								<p>Need a new room immediately? Reset active peer associations with a single tap of the refresh button to generate a new room code and QR code, automatically invalidating the old session.</p>
							</div>
							<div class="space-y-0.5">
								<h4 class="font-bold text-neutral-900 dark:text-white">Offline CSV Session Logs</h4>
								<p>Keep track of your file transfers locally. A persistent, collapsable session history records file names, sizes, statuses, and timestamps, allowing direct export to CSV for offline logs.</p>
							</div>
						</div>
					</div>
				</div>
			</div>

			<!-- convertx Section -->
			<div class="space-y-6">
				<div class="bg-neutral-50 dark:bg-neutral-900/50 p-6 rounded-2xl border border-neutral-100 dark:border-neutral-800 space-y-6">
					<div class="flex flex-col md:flex-row items-center gap-8">
						<div class="relative w-28 h-28 flex-shrink-0 mx-auto md:mx-0 md:ml-3 flex items-center justify-center">
							<img 
								src="/convetx.png" 
								alt="convertx Logo Icon" 
								class="w-full h-full object-contain"
							/>
						</div>
						<div class="flex-1 text-center md:text-left space-y-4 font-serif">
							<!-- Brand name inside card -->
							<div class="flex items-center gap-3 justify-center md:justify-start">
								<span class="font-serif text-[22px] md:text-[26px] font-bold tracking-tight text-primary dark:text-white leading-none">convertx</span>
								<span class="text-[10px] font-sans font-bold tracking-wider text-purple-500 bg-purple-500/10 px-2.5 py-0.5 rounded-full uppercase">Coming Soon</span>
							</div>
							<p class="text-base md:text-[17px] leading-[1.8] text-neutral-800 dark:text-neutral-300">
								<strong>convertx</strong> is our upcoming universal file conversion utility. Designed to seamlessly convert files from one format to another entirely within your browser, ensuring maximum privacy and blazing-fast performance without relying on cloud servers.
							</p>
							<div class="flex flex-col sm:flex-row items-center justify-between gap-4 pt-1">
								<p class="text-xs text-neutral-400 dark:text-neutral-500 font-sans">
									The ultimate local-first file converter.
								</p>
								<a 
									href="/convetx.png" 
									download="convertx-logo.png"
									class="inline-flex items-center gap-2 px-3.5 py-2 border border-neutral-200 dark:border-neutral-800 rounded-lg text-xs font-sans font-semibold hover:bg-neutral-50 dark:hover:bg-neutral-900 text-neutral-600 dark:text-neutral-400 hover:text-primary dark:hover:text-neutral-200 shadow-sm transition-all duration-200 cursor-pointer flex-shrink-0 no-underline"
								>
									<svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
										<path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4" />
										<polyline points="7 10 12 15 17 10" />
										<line x1="12" y1="15" x2="12" y2="3" />
									</svg>
									Download Logo
								</a>
							</div>
						</div>
					</div>

					<hr class="border-t border-neutral-100 dark:border-neutral-900/40 opacity-60" />

					<!-- convertx Features Docs -->
					<div class="space-y-4">
						<h3 class="text-lg md:text-xl font-bold text-neutral-400 dark:text-neutral-500 font-sans tracking-tight opacity-60">
							Key Features & Architecture
						</h3>
						<div class="space-y-3 font-sans text-sm leading-relaxed text-neutral-600 dark:text-neutral-400">
							<div class="space-y-0.5">
								<h4 class="font-bold text-neutral-900 dark:text-white">Local-First Conversion</h4>
								<p>Files are processed directly on your device using modern browser technologies. No uploads, no waiting in server queues, and 100% privacy guaranteed.</p>
							</div>
							<div class="space-y-0.5">
								<h4 class="font-bold text-neutral-900 dark:text-white">Universal Format Support</h4>
								<p>Convert between documents, images, audio, and video formats seamlessly without installing any dedicated software on your computer.</p>
							</div>
						</div>
					</div>
				</div>
			</div>

			<!-- writingos.ai Section -->
			<div class="space-y-6">
				<div class="flex flex-col md:flex-row items-center gap-8 bg-neutral-50 dark:bg-neutral-900/50 p-6 rounded-2xl border border-neutral-100 dark:border-neutral-800">
					<div class="relative w-24 h-24 flex-shrink-0 mx-auto md:mx-0 md:ml-3 flex items-center justify-center" style="filter: drop-shadow(0 0 20px rgba(229, 37, 37, 0.45));">
						<img 
							src="/writingos-icon.png" 
							alt="writingos.ai Icon" 
							class="w-full h-full object-contain"
						/>
					</div>
					<div class="flex-1 text-center md:text-left space-y-4 font-serif">
						<!-- Brand name inside card -->
						<div class="flex items-center gap-3 justify-center md:justify-start">
							<span class="font-serif text-[22px] md:text-[26px] font-bold tracking-tight text-primary dark:text-white leading-none">writing<span class="text-[#E52525]">OS</span></span>
							<span class="text-[10px] font-sans font-bold tracking-wider text-[#E52525] bg-[#E52525]/10 px-2.5 py-0.5 rounded-full uppercase">Coming Soon</span>
						</div>
						<p class="text-base md:text-[17px] leading-[1.8] text-neutral-800 dark:text-neutral-300">
						We are excited to announce <strong class="font-bold text-[#E52525]">writingOS</strong>, our upcoming next-generation platform. Designed as an AI-powered writing studio, it will help writers shape unstructured thoughts and ideas into clear, structured, and compelling stories.
					</p>
						<p class="text-xs text-neutral-400 dark:text-neutral-500 font-sans">
							Seamless integration with your writing workflow to draft, outline, and refine creative stories.
						</p>
					</div>
				</div>
			</div>

			<hr class="border-t border-neutral-150 dark:border-neutral-900" />

			<!-- Privacy First Section -->
			<div class="space-y-4 text-base md:text-[17px] leading-[1.8] text-neutral-800 dark:text-neutral-300">
				<h2 class="text-xl md:text-2xl font-bold text-primary dark:text-white tracking-tight">
					Privacy First
				</h2>
				<p>
					Your writing belongs to you. Drafts are processed entirely on your device and vanish when the session ends, and we minimize data collection wherever possible. See our <a href="/privacy" class="text-primary dark:text-white underline hover:opacity-85 font-semibold">Privacy Policy</a> for full details.
				</p>
